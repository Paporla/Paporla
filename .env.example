# ============================================
# PAPORLA — Variables de Entorno
# ============================================
# Copia este archivo como .env.local y completá los valores
# cp .env.example .env.local

# ============================================
# SUPABASE (OBLIGATORIO)
# ============================================
# URL de tu proyecto Supabase (ej: https://abc123.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key pública de Supabase (se encuentra en Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key de Supabase (SOLO del lado del servidor — NUNCA exponer al cliente)
# Se encuentra en Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# EMAIL — Resend (OBLIGATORIO para emails)
# ============================================
# API Key de Resend (https://resend.com)
RESEND_API_KEY=

# Email remitente (opcional, default: noreply@paporla.com)
RESEND_FROM_EMAIL=noreply@paporla.com

# ============================================
# CRON JOBS (OBLIGATORIO para /api/cron/*)
# ============================================
# Secreto compartido entre cron-job.org y la app.
# Las llamadas a /api/cron/* deben incluir: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ============================================
# SENTRY — Monitoreo de errores (RECOMENDADO)
# ============================================
# DSN de Sentry (opcional — si no se configura, Sentry no se activa)
NEXT_PUBLIC_SENTRY_DSN=

# Organización y proyecto en Sentry (para source maps en Vercel)
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================
# SITIO (OPCIONAL)
# ============================================
# URL pública del sitio (default: https://paporla.com)
NEXT_PUBLIC_SITE_URL=https://paporla.com

# Moneda para mostrar precios (USD, CLP, MXN, ARS, COP, PEN) — default: USD
NEXT_PUBLIC_CURRENCY=USD

# Activar modo mantenimiento (true/false) — redirige todo a /mantenimiento
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ============================================
# FOOTER — Información de contacto (OPCIONAL)
# ============================================
# Si no se configuran, las secciones del footer se ocultan automáticamente
NEXT_PUBLIC_COMPANY_ADDRESS=Santiago, Chile
NEXT_PUBLIC_COMPANY_PHONE=+56 9 1234 5678
NEXT_PUBLIC_CONTACT_EMAIL=hola@paporla.com
NEXT_PUBLIC_COMPANY_HOURS=Lun - Vie: 9am - 6pm
