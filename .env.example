# ============================================
# Paporla — Variables de entorno
# Copiar a .env.local y completar los valores
# ============================================

# ---- Supabase (requerido) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Resend (emails transaccionales) ----
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@paporla.com

# ---- Sentry (monitoreo de errores) ----
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxx
SENTRY_ORG=paporla
SENTRY_PROJECT=paporla

# ---- Google Analytics (opcional) ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ---- CRON (jobs programados) ----
CRON_SECRET=xxxxxxxxxxxx

# ---- Informacion publica ----
NEXT_PUBLIC_CONTACT_EMAIL=hola@paporla.com
NEXT_PUBLIC_COMPANY_ADDRESS=Santiago, Chile
NEXT_PUBLIC_COMPANY_PHONE=+56 9 1234 5678
