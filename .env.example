# ============================================
# Paporla — Variables de entorno
# Copiar a .env.local y completar los valores
# Actualizado 2026-09-03
# ============================================

# ---- Supabase (requerido) ----
# Produccion/staging tras la rotacion P0: claves con formato sb_...
# Desarrollo local: las claves demo que imprime `npx supabase status`
# (anon/service_role en formato JWT eyJ...; son publicas y solo viven en tu maquina).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# ---- Resend (emails transaccionales) ----
# Los fallos de envio son silenciosos por diseno (try/catch + log):
# si un correo no llega, mirar el log del servidor primero.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@paporla.com

# ---- Sentry (monitoreo de errores) ----
# DSN publico de Sentry. Se usa en el cliente (NEXT_PUBLIC) y en server/edge (SENTRY_DSN).
# Configurar en Vercel: Settings > Environment Variables > NEXT_PUBLIC_SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxx
# Solo necesarios para subir sourcemaps durante el build de Vercel
SENTRY_ORG=paporla
SENTRY_PROJECT=paporla

# ---- Google Analytics (opcional) ----
# Unica variable GA que lee el codigo (NEXT_PUBLIC_GA_ID ya no existe).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- App ----
# Local: http://localhost:3000 | Produccion: https://www.paporla.com (canonico con www)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ---- CRON (jobs programados) ----
# Bearer token que validan los 4 endpoints de /api/cron (limpieza, ciclo de
# vida, rate limits y recordatorios de recogida).
CRON_SECRET=xxxxxxxxxxxx

# ---- Informacion publica ----
NEXT_PUBLIC_CONTACT_EMAIL=hola@paporla.com
NEXT_PUBLIC_COMPANY_ADDRESS=Santiago, Chile
NEXT_PUBLIC_COMPANY_PHONE=+56 9 1234 5678